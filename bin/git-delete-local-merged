#!/bin/sh
#
# Delete all local branches that have been merged into HEAD. Stolen from
# our favorite @tekkub:
#
#   https://plus.google.com/115587336092124934674/posts/dXsagsvLakJ
#
# Edited by: Huascar Sanchez
# Replace fragile backtick/`tr` word-splitting with `xargs -r`, and extend the exclusion filter to cover `main` and `develop` in addition to `master`.

git branch --merged HEAD \
  | grep -vE '^\*|^(\s+)?(main|master|develop)$' \
  | xargs -r git branch -d
