#!/bin/sh
#
# Show local and remote branches, marking whether each branch is published.

set -e

# shellcheck source=bin/git-legit-common
. "$(dirname "$0")/git-legit-common"

legit_repo_check

pattern=${1:-'*'}
current=$(git symbolic-ref --quiet --short HEAD || true)
remote=$(legit_default_remote)

{
  if [ -n "$remote" ]; then
    git for-each-ref --format='%(refname:strip=3)' "refs/remotes/$remote" |
      awk '$0 != "HEAD" { print $0 "\tpublished" }'
  fi

  git for-each-ref --format='%(refname:short)' refs/heads |
    awk '{ print $0 "\tunpublished" }'
} | awk -v current="$current" -v pattern="$pattern" '
  function glob_to_regex(glob, regex, i, char) {
    regex = ""
    for (i = 1; i <= length(glob); i++) {
      char = substr(glob, i, 1)
      if (char == "*") {
        regex = regex ".*"
      } else if (char == "?") {
        regex = regex "."
      } else if (char ~ /[][(){}.^$+|\\]/) {
        regex = regex "\\" char
      } else {
        regex = regex char
      }
    }
    return regex
  }

  BEGIN { max = 0 }
  {
    split($0, fields, "\t")
    branch = fields[1]
    status = fields[2]
    if (branch !~ "^" glob_to_regex(pattern) "$") {
      next
    }

    if (status == "published") {
      published[branch] = 1
    } else if (!(branch in published)) {
      unpublished[branch] = 1
    }

    if (length(branch) > max) {
      max = length(branch)
    }
  }
  END {
    for (branch in published) {
      marker = branch == current ? "*" : " "
      printf "%s %-*s (published)\n", marker, max, branch
      any_printed = 1
    }
    for (branch in unpublished) {
      marker = branch == current ? "*" : " "
      printf "%s %-*s (unpublished)\n", marker, max, branch
      any_printed = 1
    }
    if (!any_printed) {
      print "No branches available"
    }
  }
' | sort -k2,2
