#!/usr/bin/env python3
# countdown: a simple terminal countdown timer.
#
# Usage:
#   countdown 5m
#   countdown 1h30m
#   countdown 90s
#   countdown 1h20m30s

import re
import sys
import time


def parse_duration(s):
    """Parse a duration string like 1h30m20s into total seconds."""
    pattern = r'^(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s?)?$'
    m = re.match(pattern, s.strip())
    if not m or not any(m.groups()):
        sys.exit(f"Error: unrecognized duration '{s}'. Use e.g. 5m, 1h30m, 90s.")
    hours   = int(m.group(1) or 0)
    minutes = int(m.group(2) or 0)
    seconds = int(m.group(3) or 0)
    total = hours * 3600 + minutes * 60 + seconds
    if total <= 0:
        sys.exit("Error: duration must be greater than zero.")
    return total


def format_duration(seconds):
    h, remainder = divmod(seconds, 3600)
    m, s = divmod(remainder, 60)
    if h:
        return f"{h:02d}:{m:02d}:{s:02d}"
    return f"{m:02d}:{s:02d}"


if len(sys.argv) != 2 or sys.argv[1] in ("-h", "--help"):
    print("Usage: countdown <duration>  e.g. 5m, 1h30m, 90s")
    sys.exit(0 if sys.argv[1:] else 1)

total = parse_duration(sys.argv[1])

def colorize(s, remaining):
    if remaining <= 10:
        return f"\033[31m{s}\033[0m"   # red
    if remaining <= 30:
        return f"\033[33m{s}\033[0m"   # yellow
    return f"\033[32m{s}\033[0m"       # green


try:
    for remaining in range(total, 0, -1):
        text = colorize(format_duration(remaining), remaining)
        print(f"\r  {text} ", end="", flush=True)
        time.sleep(1)
    print(f"\r  \033[31m{format_duration(0)}\033[0m \a")  # red at 00:00 + bell
    print("  done.")
except KeyboardInterrupt:
    print("\r  interrupted.")
    sys.exit(1)
