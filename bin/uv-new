#!/bin/bash

# Exit immediately if a command exits with a non-zero status
set -e

# Check if project name argument is provided
if [ -z "$1" ]; then
  echo "Usage: ./init_uv.sh <project_name>"
  exit 1
fi

PROJECT_NAME=$1

# 1. Initialize a new uv project
echo "Initializing uv project: $PROJECT_NAME"
uv init "$PROJECT_NAME"

# Navigate into the project directory (only affects this script execution)
cd "$PROJECT_NAME"

# 2. Create the virtual environment
echo "Creating virtual environment..."
uv venv

# 3. Add custom Ruff configuration to pyproject.toml
echo "Appending Ruff config to pyproject.toml..."
cat <<EOF >> pyproject.toml

[tool.ruff]
indent-width = 2

[tool.ruff.format]
indent-style = "space"
EOF

echo "-------------------------------------------------------"
echo "Setup complete for '$PROJECT_NAME'"
echo ""
echo "To start working, run:"
echo "  cd $PROJECT_NAME"
echo "  source .venv/bin/activate"
echo "-------------------------------------------------------"
