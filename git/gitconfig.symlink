# Local/private config goes in the include
[include]
        path = ~/.gitconfig.local
[hub]
        protocol = https
[alias]
        co = checkout
        promote = !$ZSH/bin/git-promote
        explain     = !$ZSH/bin/git-explain
        rank-contributors = !$ZSH/bin/git-rank-contributors
        count   = !git shortlog -sn
        branches = !$ZSH/bin/git-branches
        # Usage: graft | harvest <branch> <into-branch> (auto merge a branch into another)
        graft = "!f() { git merge --squash $1 $2 && git checkout $2 && git branch -D $1; }; f"
        harvest = "!f() { git checkout $2 && git merge $1 && git checkout $1; }; f"
        publish = !$ZSH/bin/git-publish
        unpublish = !$ZSH/bin/git-unpublish
        # Usage: sprout [<branch>] <new-branch>
        sprout = "!f() { git checkout -b $2 $1; }; f"
        undo = !$ZSH/bin/git-undo
[color]
        diff = auto
        status = auto
        branch = auto
        ui = true
[core]
        excludesfile = ~/.gitignore
        editor = vim
[apply]
        whitespace = nowarn
[mergetool]
        keepBackup = false
[difftool]
        prompt = false
[help]
        autocorrect = 1
[push]
        # See `git help config` (search for push.default)
        # for more information on different options of the below setting.
        #
        # Setting to git 2.0 default to suppress warning message
        default = simple
[diff "spaceman-diff"]
  command = /opt/homebrew/bin/spaceman-diff

[init]
	defaultBranch = main
[pull]
	rebase = true
